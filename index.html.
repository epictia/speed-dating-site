<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --rouge: #590000;
    --rouge-clair: #7a0000;
    --rouge-pale: #f9f0f0;
    --rouge-tres-pale: #fdf6f6;
    --or: #c9a96e;
    --or-pale: #f5edd9;
    --blanc: #ffffff;
    --gris-clair: #f8f6f4;
    --gris-texte: #6b6260;
    --noir-doux: #1a1210;
    --font-serif: 'Ovo', Georgia, serif;
    --font-body: 'Cormorant Garamond', Georgia, serif;
    --transition: 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  html { scroll-behavior: smooth; font-size: 16px; }

  body {
    font-family: var(--font-body);
    color: var(--noir-doux);
    background: var(--blanc);
    line-height: 1.75;
    overflow-x: hidden;
  }

  /* ───── TYPOGRAPHY ───── */
  h1, h2, h3, h4 { font-family: var(--font-serif); font-weight: 400; line-height: 1.25; }
  h1 { font-size: clamp(2.8rem, 6vw, 5rem); }
  h2 { font-size: clamp(2rem, 4vw, 3rem); }
  h3 { font-size: clamp(1.4rem, 3vw, 2rem); }
  h4 { font-size: 1.25rem; }
  p { font-size: clamp(1.05rem, 2vw, 1.2rem); }

  /* ───── LAYOUT ───── */
  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
  .section { padding: 6rem 0; }
  .section--alt { background: var(--gris-clair); }
  .section--rouge { background: var(--rouge); color: var(--blanc); }
  .section--rouge-pale { background: var(--rouge-tres-pale); }

  .text-center { text-align: center; }
  .text-rouge { color: var(--rouge); }

  /* ───── DIVIDERS ───── */
  .divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem auto;
    width: 60px;
  }
  .divider::before, .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rouge);
    opacity: 0.4;
  }
  .divider span {
    width: 6px;
    height: 6px;
    background: var(--rouge);
    border-radius: 50%;
    display: block;
    opacity: 0.7;
  }
  .section-label {
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rouge);
    opacity: 0.7;
    margin-bottom: 0.75rem;
    display: block;
  }

  /* ───── NAV ───── */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(89,0,0,0.08);
    transition: var(--transition);
  }
  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--rouge);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .nav-cta {
    background: var(--rouge);
    color: white;
    border: none;
    padding: 0.6rem 1.4rem;
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    cursor: pointer;
    text-decoration: none;
    transition: var(--transition);
    white-space: nowrap;
  }
  .nav-cta:hover { background: var(--rouge-clair); transform: translateY(-1px); }

  /* ───── HERO ───── */
  #hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8rem 1.5rem 5rem;
    position: relative;
    background: var(--blanc);
    overflow: hidden;
  }
  #hero::before {
    content: '';
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(89,0,0,0.06) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }
  .hero-label {
    font-family: var(--font-body);
    font-size: 0.9rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--rouge);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.8s 0.2s forwards;
  }
  .hero-title {
    max-width: 800px;
    margin: 0 auto 1rem;
    opacity: 0;
    animation: fadeUp 0.9s 0.4s forwards;
    color: var(--noir-doux);
  }
  .hero-title em {
    font-style: italic;
    color: var(--rouge);
  }
  .hero-subtitle {
    font-size: clamp(1.15rem, 2.5vw, 1.45rem);
    color: var(--gris-texte);
    max-width: 560px;
    margin: 0 auto 2.5rem;
    font-weight: 300;
    opacity: 0;
    animation: fadeUp 1s 0.6s forwards;
  }
  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    opacity: 0;
    animation: fadeUp 1s 0.8s forwards;
  }
  .btn-primary {
    background: var(--rouge);
    color: white;
    border: none;
    padding: 1rem 2.2rem;
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 1.1rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: var(--transition);
    letter-spacing: 0.02em;
  }
  .btn-primary:hover { background: var(--rouge-clair); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(89,0,0,0.25); }
  .btn-secondary {
    background: transparent;
    color: var(--rouge);
    border: 1.5px solid var(--rouge);
    padding: 1rem 2.2rem;
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 1.1rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: var(--transition);
  }
  .btn-secondary:hover { background: var(--rouge-pale); transform: translateY(-2px); }

  .hero-scroll {
    margin-top: 4rem;
    opacity: 0;
    animation: fadeUp 1s 1.2s forwards;
  }
  .hero-scroll span {
    display: block;
    width: 1px;
    height: 50px;
    background: linear-gradient(to bottom, var(--rouge), transparent);
    margin: 0 auto;
    animation: scrollLine 2s ease-in-out infinite;
  }

  /* ───── PRÉSENTATION ───── */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
    margin-top: 4rem;
  }
  .intro-visual {
    position: relative;
  }
  .intro-visual-inner {
    background: var(--rouge-pale);
    border-radius: 2px;
    padding: 3rem;
    text-align: center;
    position: relative;
  }
  .intro-visual-inner::before {
    content: '';
    position: absolute;
    top: -12px;
    left: -12px;
    right: 12px;
    bottom: 12px;
    border: 1px solid var(--rouge);
    opacity: 0.2;
    border-radius: 2px;
  }
  .intro-visual-quote {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: var(--rouge);
    font-style: italic;
    line-height: 1.3;
  }
  .intro-visual-sub {
    margin-top: 1.5rem;
    font-size: 1rem;
    color: var(--gris-texte);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--font-body);
  }

  /* ───── VALEURS ───── */
  .valeurs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    margin-top: 3.5rem;
  }
  .valeur-card {
    background: var(--blanc);
    border: 1px solid rgba(89,0,0,0.1);
    border-radius: 2px;
    padding: 2rem 1.75rem;
    transition: var(--transition);
  }
  .valeur-card:hover { border-color: rgba(89,0,0,0.3); transform: translateY(-3px); box-shadow: 0 12px 30px rgba(89,0,0,0.08); }
  .valeur-icon {
    width: 42px;
    height: 42px;
    background: var(--rouge-pale);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    color: var(--rouge);
    font-size: 1.1rem;
  }
  .valeur-card h4 { color: var(--rouge); margin-bottom: 0.5rem; font-family: var(--font-serif); }
  .valeur-card p { font-size: 1rem; color: var(--gris-texte); line-height: 1.6; }

  /* ───── NINA ───── */
  .nina-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 5rem;
    align-items: start;
  }
  .nina-portrait {
    position: relative;
  }
  .nina-portrait-box {
    background: var(--rouge);
    border-radius: 2px;
    aspect-ratio: 3/4;
    max-width: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .nina-portrait-box::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  .nina-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .nina-initials {
    font-family: var(--font-serif);
    font-size: 5rem;
    color: rgba(255,255,255,0.9);
    position: relative;
    z-index: 1;
    font-style: italic;
  }
  .nina-portrait-deco {
    position: absolute;
    bottom: -16px;
    right: -16px;
    width: 120px;
    height: 120px;
    border: 1px solid rgba(89,0,0,0.2);
    border-radius: 2px;
    z-index: -1;
  }
  .nina-contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .nina-contact-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1rem;
    color: var(--gris-texte);
    text-decoration: none;
    padding: 0.6rem 0.75rem;
    border: 1px solid rgba(89,0,0,0.12);
    border-radius: 4px;
    transition: var(--transition);
  }
  .nina-contact-item:hover { border-color: var(--rouge); color: var(--rouge); background: var(--rouge-pale); }
  .nina-contact-item svg { width: 16px; height: 16px; flex-shrink: 0; color: var(--rouge); }

  /* ───── FONCTIONNEMENT ───── */
  .steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 700px;
    margin: 3.5rem auto 0;
  }
  .step {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 2rem;
    align-items: start;
    position: relative;
    padding-bottom: 2.5rem;
  }
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 39px;
    top: 60px;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, rgba(89,0,0,0.3), transparent);
  }
  .step-num {
    width: 60px;
    height: 60px;
    background: var(--rouge);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    flex-shrink: 0;
  }
  .step-content h4 { color: var(--noir-doux); margin-bottom: 0.4rem; font-family: var(--font-serif); font-size: 1.3rem; padding-top: 0.8rem; }
  .step-content p { font-size: 1.05rem; color: var(--gris-texte); }

  /* ───── STATS PARITÉ ───── */
  .parite-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
    text-align: center;
  }
  .parite-stat {
    padding: 2.5rem 1.5rem;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 2px;
  }
  .parite-stat .num {
    font-family: var(--font-serif);
    font-size: 3.5rem;
    color: white;
    line-height: 1;
    display: block;
    margin-bottom: 0.5rem;
  }
  .parite-stat .label {
    font-size: 1rem;
    opacity: 0.8;
    font-family: var(--font-body);
  }

  /* ───── DIFFÉRENCIATION ───── */
  .diff-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-top: 3.5rem;
    align-items: start;
  }
  .diff-real h3 { color: var(--rouge); margin-bottom: 1.5rem; }
  .diff-list { list-style: none; }
  .diff-list li {
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(89,0,0,0.1);
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--noir-doux);
  }
  .diff-list li::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--rouge);
    border-radius: 50%;
    flex-shrink: 0;
  }
  .diff-pas {
    background: var(--gris-clair);
    border-radius: 2px;
    padding: 2rem;
    border-left: 3px solid var(--rouge);
  }
  .diff-pas h4 { color: var(--rouge); margin-bottom: 1.25rem; font-family: var(--font-serif); font-size: 1.3rem; }
  .diff-pas-list { list-style: none; }
  .diff-pas-list li {
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(89,0,0,0.08);
    font-size: 1rem;
    color: var(--gris-texte);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .diff-pas-list li::before {
    content: '✗';
    color: var(--rouge);
    font-weight: bold;
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* ───── ZONE DE CONFORT ───── */
  .confort-quote {
    max-width: 680px;
    margin: 0 auto 3rem;
    text-align: center;
  }
  .confort-quote blockquote {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    color: var(--blanc);
    font-style: italic;
    line-height: 1.4;
    position: relative;
  }
  .confort-quote blockquote::before {
    content: '"';
    font-size: 6rem;
    color: rgba(255,255,255,0.15);
    position: absolute;
    top: -2rem;
    left: -2rem;
    line-height: 1;
    font-family: var(--font-serif);
  }
  .confort-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 2.5rem;
  }
  .pill {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.25);
    color: white;
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    font-size: 1rem;
    font-family: var(--font-body);
    transition: var(--transition);
  }
  .pill:hover { background: rgba(255,255,255,0.2); }

  /* ───── ÉNERGIE ───── */
  .energie-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .energie-item {
    text-align: center;
    padding: 2rem 1rem;
    border: 1px solid rgba(89,0,0,0.1);
    border-radius: 2px;
    background: var(--blanc);
    transition: var(--transition);
  }
  .energie-item:hover { border-color: var(--rouge); transform: translateY(-3px); }
  .energie-item span {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--rouge);
    margin-bottom: 0.5rem;
  }
  .energie-item p { font-size: 0.95rem; color: var(--gris-texte); }

  /* ───── TÉMOIGNAGES ───── */
  .temoignages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
    margin-top: 3.5rem;
  }
  .temoignage {
    background: var(--blanc);
    border: 1px solid rgba(89,0,0,0.1);
    border-radius: 2px;
    padding: 2rem;
    position: relative;
    transition: var(--transition);
  }
  .temoignage:hover { box-shadow: 0 8px 30px rgba(89,0,0,0.08); transform: translateY(-2px); }
  .temoignage::before {
    content: '"';
    font-family: var(--font-serif);
    font-size: 4rem;
    color: var(--rouge);
    opacity: 0.25;
    position: absolute;
    top: -0.5rem;
    left: 1.5rem;
    line-height: 1;
  }
  .temoignage p {
    font-size: 1.1rem;
    color: var(--noir-doux);
    font-style: italic;
    line-height: 1.6;
    margin-bottom: 1rem;
    margin-top: 1rem;
  }
  .temoignage-auteur {
    font-size: 0.85rem;
    color: var(--gris-texte);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--font-body);
  }

  /* ───── FAQ ───── */
  .faq-list { max-width: 750px; margin: 3rem auto 0; }
  .faq-item {
    border-bottom: 1px solid rgba(89,0,0,0.12);
  }
  .faq-question {
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    padding: 1.5rem 0;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--noir-doux);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    transition: color var(--transition);
  }
  .faq-question:hover { color: var(--rouge); }
  .faq-question.open { color: var(--rouge); }
  .faq-chevron {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform var(--transition);
    color: var(--rouge);
  }
  .faq-question.open .faq-chevron { transform: rotate(180deg); }
  .faq-answer {
    display: none;
    padding: 0 0 1.5rem;
    font-size: 1.1rem;
    color: var(--gris-texte);
    line-height: 1.7;
  }
  .faq-answer.open { display: block; }

  /* ───── ÉVÉNEMENTS ───── */
  .events-venue { margin-bottom: 3.5rem; }
  .venue-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--rouge);
    margin-bottom: 0.3rem;
  }
  .venue-adresse { font-size: 0.95rem; color: var(--gris-texte); margin-bottom: 1.5rem; font-style: italic; }
  .event-cards { display: flex; flex-direction: column; gap: 1rem; }
  .event-card {
    background: var(--blanc);
    border: 1px solid rgba(89,0,0,0.12);
    border-radius: 2px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
